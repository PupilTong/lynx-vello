{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleDetection": "force",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "declaration": false,
    "isolatedDeclarations": false
  },
  "include": ["src", "test", "vitest.config.ts"]
}
