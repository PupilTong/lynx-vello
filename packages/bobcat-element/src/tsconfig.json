{
  "$schema": "https://www.schemastore.org/tsconfig",
  // The modules `bobcat-core` strips and preloads into its QuickJS realms:
  // ES2023 with no DOM and no Node globals. There is no ambient `console`
  // either: a module that logs imports `bobcat:diagnostics`'s, which is also
  // the one `bobcat:worker` installs on a worker realm's global. `paths`
  // resolves each specifier core registers to the file it registers under it;
  // the three host modules — `bobcat-internal:host`, `bobcat-internal:worker`
  // and `bobcat-internal:native-modules` — have no source and are declared in
  // `native.d.ts`.
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["es2023"],
    "types": [],
    "paths": {
      "bobcat:lynx-modules": ["./lynx-modules.ts"],
      "bobcat:global-event-emitter": ["./global-event-emitter.ts"],
      "bobcat:selector-query": ["./selector-query.ts"],
      "bobcat:element": ["./element-papi.ts"],
      "bobcat:runtime": ["./main-thread-runtime.ts"],
      "bobcat:timers": ["./timers.ts"],
      "bobcat:future": ["./future.ts"],
      "bobcat:module": ["./module.ts"],
      "bobcat:section-url": ["./section-url.ts"],
      "bobcat:bundle-fetch": ["./bundle-fetch.ts"],
      "bobcat:diagnostics": ["./diagnostics.ts"],
      "bobcat:event-target": ["./event-target.ts"],
      "bobcat:animation-frame": ["./animation-frame.ts"],
      "bobcat:system-info": ["./system-info.ts"],
      "bobcat:record": ["./record.ts"],
      "bobcat:cross-thread-context": ["./cross-thread-context.ts"],
      "bobcat-internal": ["./worker.ts"],
      "bobcat:worker": ["./worker-runtime.ts"],
      "bobcat:bts-runtime": ["./background-thread-runtime.ts"],
      "bobcat:bts": ["./bts.ts"]
    }
  },
  "include": ["*.ts"]
}
