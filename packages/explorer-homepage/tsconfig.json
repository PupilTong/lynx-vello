{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2024", "esnext.array", "esnext.collection", "esnext.iterator"],
    "types": ["node"],
    "jsx": "react-jsx",
    "jsxImportSource": "@lynx-js/react",
    // Mirrors `source.alias` in `rsbuild.config.ts`.
    "paths": {
      "@components/*": ["./components/*"],
      "@assets/*": ["./assets/*"],
    },
  },
  "include": ["index.tsx", "typing.d.ts", "components", "rsbuild.config.ts"],
}
