#!/bin/sh
# lynx-vello worktree CoW hook
# Use the primary checkout's script so older branches need not contain it.
[ "$(uname -s)" = Darwin ] || exit 0
common=$(git rev-parse --path-format=absolute --git-common-dir) || exit 0
script="$(dirname "$common")/.github/scripts/worktree-cow.py"
[ -f "$script" ] || exit 0
exec python3 "$script" hook "$@"
