{
  "extends": ["@tsconfig/strictest", "@tsconfig/node22"],
  "compilerOptions": {
    "incremental": true,
    "useDefineForClassFields": true,
    "allowJs": false,
    "checkJs": false,
    "declaration": true,
    "sourceMap": true,
    "stripInternal": true,
    "verbatimModuleSyntax": true,
    "isolatedDeclarations": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": []
}
