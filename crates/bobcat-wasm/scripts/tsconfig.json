{
  "$schema": "https://www.schemastore.org/tsconfig",
  // The package's Node scripts, which Node runs as written. The DOM library
  // is here because `pointer-input.test.ts` imports the facade.
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["es2023", "dom"],
    "types": ["node"],
    "module": "nodenext",
    "moduleResolution": "nodenext"
  },
  "include": ["*.ts"]
}
