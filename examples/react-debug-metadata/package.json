{
  "name": "@lynx-js/example-react-debug-metadata",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm run build:producer && pnpm run build:consumer",
    "build:consumer": "cross-env DEBUG=rspeedy,rsbuild rspeedy build --config lynx.config.consumer.ts",
    "build:producer": "cross-env DEBUG=rspeedy,rsbuild rspeedy build --config lynx.config.producer.ts",
    "dev": "node scripts/serve.ts dev",
    "dev:consumer": "rspeedy dev --config lynx.config.consumer.ts",
    "dev:producer": "rspeedy dev --config lynx.config.producer.ts",
    "preview": "node scripts/serve.ts preview",
    "preview:consumer": "rspeedy preview --config lynx.config.consumer.ts",
    "preview:producer": "rspeedy preview --config lynx.config.producer.ts",
    "test": "rstest run --config error-remapping/rstest.config.ts",
    "test:update": "rstest run -u --config error-remapping/rstest.config.ts"
  },
  "dependencies": {
    "@lynx-js/react": "catalog:"
  },
  "devDependencies": {
    "@lynx-js/preact-devtools": "catalog:",
    "@lynx-js/qrcode-rsbuild-plugin": "catalog:",
    "@lynx-js/react-rsbuild-plugin": "catalog:",
    "@lynx-js/rspeedy": "catalog:",
    "@lynx-js/types": "catalog:",
    "@rstest/core": "0.11.2",
    "@types/react": "18.3.28",
    "cross-env": "^10.1.0",
    "source-map": "^0.7.6",
    "typescript": "catalog:rspeedy"
  }
}
