{
  "name": "@lynx-js/example-react-debug-metadata",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm run build:producer && pnpm run build:consumer",
    "build:consumer": "cross-env DEBUG=lynx,rsbuild rsbuild build --config rsbuild.config.consumer.ts",
    "build:producer": "cross-env DEBUG=lynx,rsbuild rsbuild build --config rsbuild.config.producer.ts",
    "dev": "node scripts/serve.ts dev",
    "dev:consumer": "rsbuild dev --config rsbuild.config.consumer.ts",
    "dev:producer": "rsbuild dev --config rsbuild.config.producer.ts",
    "preview": "node scripts/serve.ts preview",
    "preview:consumer": "rsbuild preview --config rsbuild.config.consumer.ts",
    "preview:producer": "rsbuild preview --config rsbuild.config.producer.ts",
    "test": "rstest run --config error-remapping/rstest.config.ts",
    "test:update": "rstest run -u --config error-remapping/rstest.config.ts"
  },
  "dependencies": {
    "@lynx-js/react": "catalog:"
  },
  "devDependencies": {
    "@lynx-js/preact-devtools": "catalog:",
    "@lynx-js/qrcode-rsbuild-plugin": "catalog:",
    "@lynx-js/react-rsbuild-plugin": "catalog:",
    "@lynx-js/rsbuild-plugin": "catalog:",
    "@lynx-js/types": "catalog:",
    "@rsbuild/core": "catalog:",
    "@rstest/core": "0.11.2",
    "@types/react": "18.3.28",
    "cross-env": "^10.1.0",
    "source-map": "^0.7.6",
    "typescript": "catalog:"
  }
}
