{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "@lynx-js/react",
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,
    "isolatedDeclarations": false,
    "paths": {
      "@/*": ["./src/*"],
    },
  },
  "include": ["src", "lynx.config.js", "test", "vitest.config.ts", "tailwind.config.ts"],
  "exclude": ["dist/"],
}
