{
  "name": "@lynx-js/example-react-lazy-bundle-standalone",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm run build:querycomponent && pnpm run build:fetchbundle",
    "build:consumer": "rsbuild build --config rsbuild.config.consumer.ts",
    "build:fetchbundle": "cross-env LAZY_BUNDLE_FETCHBUNDLE=1 pnpm run build:querycomponent",
    "build:producer": "rsbuild build --config rsbuild.config.producer.ts",
    "build:querycomponent": "pnpm run --parallel \"/^build:(producer|consumer)$/\"",
    "dev": "node scripts/serve.ts dev",
    "dev:consumer": "rsbuild dev --config rsbuild.config.consumer.ts",
    "dev:fetchbundle": "cross-env LAZY_BUNDLE_FETCHBUNDLE=1 node scripts/serve.ts dev",
    "dev:producer": "rsbuild dev --config rsbuild.config.producer.ts",
    "preview": "node scripts/serve.ts preview",
    "preview:consumer": "rsbuild preview --config rsbuild.config.consumer.ts",
    "preview:fetchbundle": "cross-env LAZY_BUNDLE_FETCHBUNDLE=1 node scripts/serve.ts preview",
    "preview:producer": "rsbuild preview --config rsbuild.config.producer.ts"
  },
  "dependencies": {
    "@lynx-js/react": "catalog:"
  },
  "devDependencies": {
    "@lynx-js/preact-devtools": "catalog:",
    "@lynx-js/qrcode-rsbuild-plugin": "catalog:",
    "@lynx-js/react-rsbuild-plugin": "catalog:",
    "@lynx-js/rsbuild-plugin": "catalog:",
    "@lynx-js/types": "catalog:",
    "@rsbuild/core": "catalog:",
    "@types/react": "18.3.28",
    "cross-env": "^10.1.0",
    "typescript": "catalog:"
  }
}
